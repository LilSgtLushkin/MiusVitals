+// A rest sample is exact only when two consecutive packets say the same transform and zero velocity.
+// Such a transform may be left in place when the local object already contains those exact bytes.
+// This is write elision, not a lower transform/snapshot rate: any change still takes the normal path.
+static bool held_at_rest(const Held &h)
+{
+    static const float zero[3] = {};
+    return h.have == 2 &&
+           !memcmp(h.a.rec.pos, h.b.rec.pos, sizeof h.b.rec.pos) &&
+           !memcmp(h.a.rec.rot, h.b.rec.rot, sizeof h.b.rec.rot) &&
+           !memcmp(h.a.rec.lin, zero, sizeof zero) && !memcmp(h.b.rec.lin, zero, sizeof zero) &&
+           !memcmp(h.a.rec.ang, zero, sizeof zero) && !memcmp(h.b.rec.ang, zero, sizeof zero);
+}
+
+static bool transform_is_already_set(char *u, const float *pos, const float *rot)
+{
+    static const float zero[3] = {};
+    float *upos = (float *)(u + UNIT_POS), *urot = (float *)(u + UNIT_ROT), *uinv = (float *)(u + UNIT_INV);
+    if (memcmp(upos, pos, 3 * sizeof(float)) || memcmp(u + UNIT_LIN, zero, sizeof zero) || memcmp(u + UNIT_ANG, zero, sizeof zero))
+        return false;
+    for (int row = 0; row < 3; row++) {
+        if (memcmp(urot + row * 4, rot + row * 3, 3 * sizeof(float))) return false;
+        for (int col = 0; col < 3; col++)
+            if (memcmp(uinv + col * 4 + row, rot + row * 3 + col, sizeof(float))) return false;
+    }
+    return true;
+}
