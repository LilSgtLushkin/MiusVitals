diff --git a/development/upstream/miusplayer-public-43b2736/basic_network/operation_turn.h b/development/upstream/miusplayer-public-43b2736/basic_network/operation_turn.h
new file mode 100644
index 0000000..b9a4fa1
--- /dev/null
+++ b/development/upstream/miusplayer-public-43b2736/basic_network/operation_turn.h
@@ -0,0 +1,46 @@
+// Compact, version-12-compatible operational-map turn state carried in Welcome.map_flags.
+// The wire layout is unchanged: old launchers can still hand the map to a new module;
+// two new modules use bits 2..3 to serialize host then client orders.
+#pragma once
+
+enum MapTurnStage {
+    MAP_TURN_HOST = 0,
+    MAP_TURN_CLIENT = 1,
+    MAP_TURN_COLLECT = 2,
+};
+
+enum {
+    MAP_FLAG_COLLECT = 1u << 0,
+    MAP_FLAG_HOST_DONE = 1u << 1,
+    MAP_FLAG_TURN_SHIFT = 2,
+    MAP_FLAG_TURN_MASK = 3u << MAP_FLAG_TURN_SHIFT,
+    MAP_FLAG_EPOCH_SHIFT = 8,
+};
+
+inline MapTurnStage map_turn_from_value(unsigned value)
+{
+    return value == MAP_TURN_CLIENT ? MAP_TURN_CLIENT : value == MAP_TURN_COLLECT ? MAP_TURN_COLLECT : MAP_TURN_HOST;
+}
+
+inline MapTurnStage map_turn_from_flags(unsigned flags)
+{
+    return map_turn_from_value((flags & MAP_FLAG_TURN_MASK) >> MAP_FLAG_TURN_SHIFT);
+}
+
+inline unsigned map_turn_flags(unsigned epoch, MapTurnStage stage, bool collecting, bool host_done)
+{
+    return (collecting ? MAP_FLAG_COLLECT : 0) |
+           (host_done ? MAP_FLAG_HOST_DONE : 0) |
+           ((unsigned)stage << MAP_FLAG_TURN_SHIFT) |
+           (epoch << MAP_FLAG_EPOCH_SHIFT);
+}
+
+inline unsigned map_epoch_from_flags(unsigned flags)
+{
+    return flags >> MAP_FLAG_EPOCH_SHIFT;
+}
+
+inline bool map_turn_allows_input(bool host, MapTurnStage stage)
+{
+    return host ? stage == MAP_TURN_HOST : stage == MAP_TURN_CLIENT;
+}
