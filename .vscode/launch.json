{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to tacgame (Debug module)",
            "type": "cppvsdbg",
            "request": "attach",
            "processName": "tacgame.exe",
            "symbolSearchPath": "${workspaceFolder}/development/net-v21/build/module-debug",
            "justMyCode": false,
            "detail": "бой: подключиться к запущенной игре и отлаживать наш модуль по исходникам"
        },
        {
            "name": "Attach to opgame (Debug module)",
            "type": "cppvsdbg",
            "request": "attach",
            "processName": "opgame.exe",
