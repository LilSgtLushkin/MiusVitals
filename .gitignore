# Local build and test output
/build/

# build.bat writes every configuration here (build\module, build\module-debug, build\selftest, ...)
development/versions/*/build/
/dist/
development/unified-kit-source/state/
development/unified-kit-source/build_report.txt
development/unified-fps-kit-source/state/
development/unified-fps-kit-source/build_report.txt
# A public MiusPlayer source build is a local analysis candidate, never a checked-in game artifact.
development/upstream/miusplayer-public-43b2736/basic_network/build/
development/upstream/miusplayer-public-43b2736/Multiplayer_DropIn/
*.o
*.obj
*.lib
*.pdb
*.exe
# ...but the checked-in join launcher ships inside both kits; an ignored copy would
# silently disappear from a fresh `git add -A`.
!development/unified-kit-source/files/mp_join.exe
!development/unified-fps-kit-source/files/mp_join.exe
*.log

# Python / editor noise
__pycache__/
*.py[cod]
.venv/
.vscode/
.idea/

# VS Code: личные настройки не храним, а проектную конфигурацию сборки — да, иначе новый
# разработчик не получит задачи сборки и запуск из коробки.
.vscode/*
!/.vscode/tasks.json
!/.vscode/launch.json
!/.vscode/c_cpp_properties.json
!/.vscode/extensions.json
!/.vscode/settings.json

# Visual Studio: кэш решения и личные настройки не храним, проекты — да.
.vs/
*.suo
*.user
*.vcxproj.user
